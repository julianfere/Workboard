{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "spike-terminal",
  "version": "0.0.0",
  "identifier": "dev.workboard.spike-terminal",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Spike terminal (Tauri + portable-pty + xterm.js)",
        "width": 1100,
        "height": 720
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}
